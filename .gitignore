# ---- ビルド成果物 ----
target/
**/*.rs.bk
node_modules/
/app/dist/
/app/src-tauri/gen/
# アプリのリリースビルド(scripts/build-release.bat が作る)
/release/
# Godot 拡張の配布物(godot/build_windows.bat が作る)。デモ側の .godot/ と bin/ は godot/demo/.gitignore
/godot/dist/

# ---- 手元にだけ置くデータ(公開しない) ----
# テスト用プロジェクト・デバッグ用スクショ(チャットのセッション ID 等を含む)
/tests/
/debugs/
# SoundFont と、開発用にダウンロードした学習済みモデル(同梱するモデルは crates/glaux-ml/models/)
/SoundFonts/
/models/

# 開発者の手元だけで使う文書(開発規約・引き継ぎ。過去の版はコミット履歴にある)
/CLAUDE.md
/docs/HANDOFF.md
/docs/ui-review/

# ---- 個人設定・エディタ・OS ----
.claude/settings.local.json
claude_sandbox.bat
.env
.env.*
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 一時ファイル ----
*.tmp
*.log

# 開いているプロジェクトの排他ロック(Glaux が作る)
.glaux.lock
