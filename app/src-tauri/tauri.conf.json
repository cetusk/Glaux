{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glaux",
  "version": "0.2.0",
  "identifier": "dev.glaux.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Glaux",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "cetusk",
    "category": "Music",
    "shortDescription": "AI と一緒に曲を作れる、シンプルで軽量なデスクトップ DAW",
    "longDescription": "Glaux は AI(Claude)と共同作業できるデスクトップ DAW です。すべての編集は履歴に残り、AI はアプリ内の MCP サーバーから同じプロジェクトを編集します。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Japanese"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
